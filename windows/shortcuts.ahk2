;# Persistent  ; Make the script persistent
; Remap CapsLock to function as either Alt or Esc based on the duration of the press
/*
*CapsLock::RemapCapsLock()
RemapCapsLock()
{
    ; Get the current tick count
    cDown := A_TickCount
    ; Send Alt key down
    ; Send {Blind}{Alt Down}
    Send "{Blind}{Alt Down}"
    ; Wait for CapsLock to be released
    KeyWait "CapsLock"
    ; Calculate the duration of the press
    duration := A_TickCount - cDown
    ; If the duration is less than 150 milliseconds, send Alt Up and Esc
    if (duration < 150)
    {
        Send "{Blind}{Alt Up}{Esc}"
    }
    else  ; Otherwise, send Alt Up
    {
        Send "{Blind}{Alt Up}"
    }
}
*/

*RShift::RemapRShift()
RemapRShift()
{
    cDown := A_TickCount
    Send "{Blind}{RShift Down}"
    KeyWait "RShift"
    duration := A_TickCount - cDown
    if (duration < 100) {
        Send "{Blind}{RShift Up}{]}"
    }
    else
    {
        Send "{Blind}{RShift Up}"
    }
}
*LShift::RemapLShift()
RemapLShift()
{
    cDown := A_TickCount
    Send "{Blind}{LShift Down}"
    KeyWait "LShift"
    duration := A_TickCount - cDown
    if (duration < 100) {
        Send "{Blind}{LShift Up}{[}"
    }
    else
    {
        Send "{Blind}{LShift Up}"
    }
}

